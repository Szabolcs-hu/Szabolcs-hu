<Window x:Class="MTASALauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MTASALauncher.ViewModels"
        xmlns:h="clr-namespace:MTASALauncher.Helpers"
        Title="MTA:SA Launcher"
        Height="640" Width="960"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <h:BoolToOnlineColorConverter x:Key="OnlineColor"/>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>
        <h:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <h:NullToVisibilityConverter x:Key="NullVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="BgDeep"     Color="#090D14"/>
        <SolidColorBrush x:Key="BgPanel"    Color="#111827"/>
        <SolidColorBrush x:Key="BgCard"     Color="#1A2236"/>
        <SolidColorBrush x:Key="BgSelected" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="BorderCol"  Color="#1E3A5F"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2196F3"/>
        <SolidColorBrush x:Key="AccentHover"Color="#42A5F5"/>
        <SolidColorBrush x:Key="TextPrimary"Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextSecond" Color="#7A8899"/>
        <SolidColorBrush x:Key="GreenOnline"Color="#4CAF50"/>
        <SolidColorBrush x:Key="RedOffline" Color="#EF5350"/>

        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Input style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#1E2D40"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A3F57"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (red remove) -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EF5350"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button -->
        <Style x:Key="BtnTab" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window control button -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A3A4A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C62828"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Server list item -->
        <DataTemplate x:Key="ServerItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Online indicator dot -->
                <Ellipse Grid.Column="0" Width="7" Height="7"
                         VerticalAlignment="Center"
                         Fill="{Binding IsOnline, Converter={StaticResource OnlineColor}}"
                         Opacity="{Binding IsQuerying, Converter={StaticResource BoolVis}, ConverterParameter=0.5}"/>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontFamily="Segoe UI Semibold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Address}" FontSize="11"
                               Foreground="{StaticResource TextSecond}" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Player count badge -->
                <Border Grid.Column="2" Background="#1A2236" CornerRadius="3"
                        Padding="6,2" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="{Binding PlayersDisplay}" FontSize="11"
                               Foreground="{StaticResource TextSecond}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ListBox style -->
        <Style x:Key="ServerListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A2A3A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar style (slim dark) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2A3A4A" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextTransform" Value="Uppercase"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Root border with rounded corners and drop shadow -->
    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
        <Grid Background="{StaticResource BgDeep}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="42"/>   <!-- Tab bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="48"/>   <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Grid Grid.Row="0" Background="#0D1520"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  WindowChrome.IsHitTestVisibleInChrome="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <!-- MTA circle logo -->
                    <Ellipse Width="22" Height="22" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2196F3" Offset="0"/>
                                <GradientStop Color="#0D47A1" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="MTA:SA LAUNCHER" FontFamily="Segoe UI Black"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}" LetterSpacing="2"/>
                </StackPanel>

                <!-- Window control buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinBtn}" Content="&#xE921;"
                            Click="MinimizeButton_Click" ToolTip="Minimalizálás"/>
                    <Button Style="{StaticResource WinBtn}" Content="&#xE922;"
                            Click="MaximizeButton_Click" ToolTip="Maximalizálás"/>
                    <Button Style="{StaticResource WinBtnClose}" Content="&#xE8BB;"
                            Click="CloseButton_Click" ToolTip="Bezárás"/>
                </StackPanel>
            </Grid>

            <!-- ── Tab bar ── -->
            <Border Grid.Row="1" Background="#0D1520" BorderBrush="{StaticResource BorderCol}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <ToggleButton Style="{StaticResource BtnTab}" Content="🖥  Szerver lista"
                                  IsChecked="{Binding IsServersTab, Mode=OneWay}"
                                  Command="{Binding ShowServersCommand}"/>
                    <ToggleButton Style="{StaticResource BtnTab}" Content="⚙  Beállítások"
                                  IsChecked="{Binding IsSettingsTab, Mode=OneWay}"
                                  Command="{Binding ShowSettingsCommand}"/>
                </StackPanel>
            </Border>

            <!-- ── MAIN CONTENT ── -->
            <Grid Grid.Row="2">

                <!-- ═══ SERVERS TAB ═══ -->
                <Grid Visibility="{Binding IsServersTab, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="220"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Favorites panel -->
                    <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Padding="8,8,4,0">
                            <ListBox ItemsSource="{Binding Servers}"
                                     SelectedItem="{Binding SelectedServer}"
                                     ItemTemplate="{StaticResource ServerItemTemplate}"
                                     Style="{StaticResource ServerListBox}"
                                     VirtualizingPanel.IsVirtualizing="True"/>
                        </ScrollViewer>

                        <!-- Add server form -->
                        <Border Grid.Row="1" Background="#0D1520" BorderBrush="{StaticResource BorderCol}"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="SZERVER HOZZÁADÁSA" Style="{StaticResource SectionLabel}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding NewIpPort, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="IP:port (pl. 127.0.0.1:22003)"
                                         Margin="0,0,0,5">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Szerver neve (opcionális)"
                                         Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="＋  Hozzáad"
                                            Style="{StaticResource BtnPrimary}"
                                            Command="{Binding AddServerCommand}"
                                            Padding="0,7"/>
                                    <Button Grid.Column="2" Content="−"
                                            Style="{StaticResource BtnDanger}"
                                            Command="{Binding RemoveServerCommand}"
                                            Width="34" Padding="0"
                                            ToolTip="Kijelölt szerver törlése"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderCol}"/>

                    <!-- Right: Server details -->
                    <Grid Grid.Column="2" Margin="20,16,20,12">

                        <!-- No server selected -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedServer, Converter={StaticResource NullVis}, ConverterParameter=inverse}">
                            <TextBlock Text="🖥" FontSize="48" HorizontalAlignment="Center" Opacity="0.2"/>
                            <TextBlock Text="Válassz ki egy szervert a listából"
                                       Foreground="{StaticResource TextSecond}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="vagy adj hozzá újat a bal panelen"
                                       Foreground="{StaticResource TextSecond}"
                                       FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Server details -->
                        <StackPanel Visibility="{Binding SelectedServer, Converter={StaticResource NullVis}}">
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
                            </Grid.Resources>

                            <!-- Server name + online badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding SelectedServer.IsOnline, Converter={StaticResource OnlineColor}}"/>
                                <TextBlock Text="{Binding SelectedServer.DisplayName}"
                                           FontSize="20" FontFamily="Segoe UI Semibold"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Background="#0D3060" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedServer.IsOnline, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ONLINE" FontSize="10" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource GreenOnline}"/>
                                </Border>
                                <Border Background="#3D0000" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedServer.IsOnline, Converter={StaticResource InvBoolVis}}">
                                    <TextBlock Text="OFFLINE" FontSize="10" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource RedOffline}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedServer.Address}"
                                       Foreground="{StaticResource TextSecond}" FontSize="13" Margin="0,0,0,20"/>

                            <!-- Stats cards -->
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
                                <!-- Players -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="6"
                                        Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="JÁTÉKOSOK" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding SelectedServer.PlayersDisplay}"
                                                   FontSize="22" FontFamily="Segoe UI Black"
                                                   Foreground="{StaticResource AccentBlue}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Game mode -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="6"
                                        Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="JÁTÉKMÓD" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock FontSize="14" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <Binding Path="SelectedServer.GameMode"
                                                         FallbackValue="—" TargetNullValue="—"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- Map -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="6"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="TÉRKÉP" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock FontSize="14" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <Binding Path="SelectedServer.MapName"
                                                         FallbackValue="—" TargetNullValue="—"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶  Csatlakozás"
                                        Style="{StaticResource BtnPrimary}"
                                        Command="{Binding ConnectCommand}"
                                        Padding="20,10" FontSize="14" Margin="0,0,10,0"/>
                                <Button Content="↻  Frissítés"
                                        Style="{StaticResource BtnSecondary}"
                                        Command="{Binding RefreshSelectedCommand}"
                                        Padding="14,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ═══ SETTINGS TAB ═══ -->
                <ScrollViewer Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolVis}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,24" MaxWidth="600">

                        <!-- MTA:SA path -->
                        <TextBlock Text="MTA:SA ELÉRÉSI ÚT" Style="{StaticResource SectionLabel}"/>
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Multi Theft Auto.exe helye" Foreground="{StaticResource TextSecond}"
                                           FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputStyle}"
                                             Text="{Binding MtaExePath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="📁  Tallózás"
                                            Style="{StaticResource BtnSecondary}"
                                            Command="{Binding BrowseExeCommand}"
                                            Padding="12,7"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quick connect -->
                        <TextBlock Text="GYORS CSATLAKOZÁS" Style="{StaticResource SectionLabel}"/>
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Csatlakozás közvetlenül IP-cím alapján"
                                           Foreground="{StaticResource TextSecond}"
                                           FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputStyle}"
                                             Text="{Binding QuickConnect, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="127.0.0.1:22003"/>
                                    <Button Grid.Column="2" Content="▶  Csatlakozás"
                                            Style="{StaticResource BtnPrimary}"
                                            Command="{Binding QuickConnectCommand}"
                                            Padding="14,7"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save settings -->
                        <Button Content="💾  Beállítások mentése"
                                Style="{StaticResource BtnPrimary}"
                                Command="{Binding SaveSettingsCommand}"
                                HorizontalAlignment="Left" Padding="18,10"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- ── Bottom bar ── -->
            <Border Grid.Row="3" Background="#0D1520"
                    BorderBrush="{StaticResource BorderCol}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🚀  MTA:SA Indítása"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding LaunchCommand}"
                            Padding="14,0" Height="32"/>

                    <Button Grid.Column="2" Content="↻  Összes frissítés"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding RefreshAllCommand}"
                            Padding="12,0" Height="32"/>

                    <TextBlock Grid.Column="3" Text="{Binding Status}"
                               Foreground="{StaticResource TextSecond}" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="4" Text="MTA:SA Launcher v1.0"
                               Foreground="#2A3A4A" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
